# Production env on Hostinger VPS. The real .env.prod (with secrets) is NEVER committed.
# A populated copy lives at /root/ecommerce-mvp/deploy/.env.prod on the VPS.

POSTGRES_USER=medusa
POSTGRES_DB=medusa_db
POSTGRES_PASSWORD=replace-me

JWT_SECRET=replace-me
COOKIE_SECRET=replace-me

# Public backend URL — HTTPS once Caddy + Let's Encrypt issues.
MEDUSA_BACKEND_URL=https://srv1162617.hstgr.cloud

# CORS allowlists. Add mobile dev origin (192.168.x.x) and prod web domain when ready.
STORE_CORS=https://srv1162617.hstgr.cloud,http://192.168.33.6:8081,http://192.168.33.6:19006,exp://192.168.33.6:8081
ADMIN_CORS=https://srv1162617.hstgr.cloud
AUTH_CORS=https://srv1162617.hstgr.cloud,http://192.168.33.6:8081,http://192.168.33.6:19006,exp://192.168.33.6:8081

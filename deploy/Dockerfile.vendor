# deploy/Dockerfile.vendor
# Standalone install (not via workspace) to avoid Next.js version conflicts
# between vendor (Next 14 + React 18) and storefront (Next 15 + React 19).

FROM node:20-alpine AS build
WORKDIR /app
COPY backend/apps/vendor/package.json ./
RUN npm install --no-audit --no-fund --workspaces=false
COPY backend/apps/vendor/ ./
ARG NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://srv1162617.hstgr.cloud
ENV NEXT_PUBLIC_MEDUSA_BACKEND_URL=$NEXT_PUBLIC_MEDUSA_BACKEND_URL
RUN npm run build

FROM node:20-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/.next ./.next
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/node_modules ./node_modules
EXPOSE 9100
CMD ["npx", "next", "start", "-p", "9100"]

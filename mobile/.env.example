# Local development: phone on same Wi-Fi as your laptop.
# 192.168.33.6 is this laptop's LAN IP — make sure your phone is on the same network.
# For Android emulator use http://10.0.2.2:9000 instead.
EXPO_PUBLIC_MEDUSA_BACKEND_URL=http://192.168.33.6:9000

# Get this from Medusa Admin → Settings → Publishable API Keys (created after seed).
EXPO_PUBLIC_MEDUSA_PUBLISHABLE_API_KEY=replace-with-medusa-publishable-key

# OpenAI key for Najma chat (gpt-4o-mini).
# Optional. Najma chat falls back to a "launching soon" message when missing.
EXPO_PUBLIC_OPENAI_API_KEY=sk-...

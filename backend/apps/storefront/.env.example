# Customer-facing web storefront. Same Medusa backend as the mobile app.

# When running backend locally:
MEDUSA_BACKEND_URL=http://localhost:9000

# When backend is deployed on Hostinger VPS:
# MEDUSA_BACKEND_URL=https://srv1162617.hstgr.cloud

# Get this from Medusa Admin → Settings → Publishable API Keys after first boot.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=replace-with-publishable-key

# Storefront's own URL (used for SEO / canonical / OG tags).
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Default region if browser can't be geo-detected. Lower-case ISO-2.
NEXT_PUBLIC_DEFAULT_REGION=us

# Stripe / Medusa Payments — leave empty for MVP (manual provider only).
NEXT_PUBLIC_STRIPE_KEY=
NEXT_PUBLIC_MEDUSA_PAYMENTS_PUBLISHABLE_KEY=
NEXT_PUBLIC_MEDUSA_PAYMENTS_ACCOUNT_ID=

# Next.js on-demand revalidation token (any random string).
REVALIDATE_SECRET=replace-with-random-secret
